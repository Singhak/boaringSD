      "choices": [
        {
          "id": "refuse-backwards",
          "label": "Track the last timestamp; wait or fail while the clock is behind",
          "correct": true,
          "metricsAfter": [
            {
              "key": "cpu",
              "label": "CPU",
              "value": 58,
              "unit": "%",
              "tone": "good"
            },
            {
              "key": "p95",
              "label": "p95 latency",
              "value": 24,
              "unit": "ms",
              "tone": "good"
            },
            {
              "key": "errors",
              "label": "Errors",
              "value": 0,
              "unit": "errors",
              "tone": "good"
            }
          ],
          "resultTitle": "No reused timestamps",
          "resultBody": "The worker compares each tick with the last millisecond it used and stalls or errors for up to 800 ms instead of reusing it; NTP is also set to slew, not step, so pauses stay rare."
        },
        {
          "id": "wider-sequence",
          "label": "Widen the Snowflake sequence field from 12 bits to 16 bits",
          "correct": false,
          "metricsAfter": [
            {
              "key": "cpu",
              "label": "CPU",
              "value": 62,
              "unit": "%",
              "tone": "bad"
            },
            {
              "key": "p95",
              "label": "p95 latency",
              "value": 21,
              "unit": "ms",
              "tone": "bad"
            },
            {
              "key": "errors",
              "label": "Errors",
              "value": 3100,
              "unit": "errors",
              "tone": "bad"
            }
          ],
          "resultTitle": "More room, same collision",
          "resultBody": "A wider sequence only raises IDs per millisecond. After the step the sequence resets to 0 for a timestamp already used, so the same 3,100 IDs are minted again.",
          "retry": true
        },
        {
          "id": "retry-on-conflict",
          "label": "Catch duplicate-key errors in the DB and regenerate the event ID",
          "correct": false,
          "metricsAfter": [
            {
              "key": "cpu",
              "label": "CPU",
              "value": 64,
              "unit": "%",
              "tone": "bad"
            },
            {
              "key": "p95",
              "label": "p95 latency",
              "value": 35,
              "unit": "ms",
              "tone": "bad"
            },
            {
              "key": "errors",
              "label": "Errors",
              "value": 2400,
              "unit": "errors",
              "tone": "bad"
            }
          ],
          "resultTitle": "The duplicates never hit the DB",
          "resultBody": "Kafka consumers, caches and logs see the ID before any unique index does, so events are still dropped as repeats; the DB retry only covers one of several sinks.",
          "retry": true
        }
      ],
      "hints": [
        "Snowflake assumes time only moves forward.",
        "Which bits repeat when the timestamp repeats?",
        "Remember the last millisecond the worker issued."
      ],
