      "choices": [
        {
          "id": "w2r2",
          "label": "Use W=2 and R=2 so every read set overlaps the write set",
          "correct": true,
          "metricsAfter": [
            {
              "key": "cpu",
              "label": "CPU",
              "value": 35,
              "unit": "%",
              "tone": "good"
            },
            {
              "key": "p95",
              "label": "p95 latency",
              "value": 20,
              "unit": "ms",
              "tone": "good"
            },
            {
              "key": "errors",
              "label": "Errors",
              "value": 0,
              "unit": "errors",
              "tone": "good"
            }
          ],
          "resultTitle": "Read and write sets overlap",
          "resultBody": "With R + W > N, any two replicas you read share at least one with the two that acked the write, so the newest value is always seen."
        },
        {
          "id": "w1r3",
          "label": "Keep W=1 but raise R to 2 on the client's retry path",
          "correct": false,
          "metricsAfter": [
            {
              "key": "cpu",
              "label": "CPU",
              "value": 63,
              "unit": "%",
              "tone": "bad"
            },
            {
              "key": "p95",
              "label": "p95 latency",
              "value": 58,
              "unit": "ms",
              "tone": "bad"
            },
            {
              "key": "errors",
              "label": "Errors",
              "value": 434,
              "unit": "errors",
              "tone": "bad"
            }
          ],
          "resultTitle": "Overlap isn't guaranteed",
          "resultBody": "R=2 with W=1 gives R + W = 3, not more than N, so both replicas read can still miss the single replica that took the write.",
          "retry": true
        },
        {
          "id": "w3r0",
          "label": "Write to all three replicas asynchronously after acking W=1",
          "correct": false,
          "metricsAfter": [
            {
              "key": "cpu",
              "label": "CPU",
              "value": 64,
              "unit": "%",
              "tone": "bad"
            },
            {
              "key": "p95",
              "label": "p95 latency",
              "value": 63,
              "unit": "ms",
              "tone": "bad"
            },
            {
              "key": "errors",
              "label": "Errors",
              "value": 465,
              "unit": "errors",
              "tone": "bad"
            }
          ],
          "resultTitle": "The ack came before the copies",
          "resultBody": "Async fan-out still acks after one replica, so a read that lands on another replica before the copy arrives sees the old value.",
          "retry": true
        }
      ],
      "hints": [
        "When must a read set share a node with a write set?",
        "Compare R + W with N.",
        "Overlap guarantees you see the latest write."
      ],
