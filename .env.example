# Copy to .env.local and fill in. Never commit real keys.

# PostgreSQL for the lesson catalogue (/api/lessons falls back to bundled JSON without it)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boaringsd"

# "Defend your call" answer grading. Leave LLM_PROVIDER empty to use self-assessment.
# Supported providers: gemini
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional; defaults to gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash
# Optional; tried when LLM_MODEL is missing or keeps failing. Defaults to gemini-2.5-flash. "off" disables it.
LLM_FALLBACK_MODEL=gemini-2.5-flash
# Optional: anonymous product events (see src/lib/events.ts) are POSTed here with sendBeacon.
# Leave empty to keep events in the browser only.
NEXT_PUBLIC_EVENTS_URL=/api/events

# Password for /admin/events (open with ?key=...). Leave empty to disable the page.
ADMIN_KEY=
